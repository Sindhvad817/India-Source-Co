---
layout: layouts/base.njk
---
{#- Simple text page (e.g. the privacy policy): an H1 and Markdown body. -#}
  <section class="section">
    <div class="section-inner page-prose">
      {%- if eyebrow %}
      <span class="eyebrow">{{ eyebrow }}</span>
      {%- endif %}
      <h1>{{ h1 }}</h1>
      {%- if effectiveDate %}
      <p class="page-meta">Effective {{ effectiveDate }}</p>
      {%- endif %}
{{ content | safe }}
    </div>
  </section>
